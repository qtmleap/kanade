# Kanade / wrapper-v2 environment template.
#
# Copy this file to `.env` (which is gitignored) and fill in your Apple ID:
#   cp .env.example .env
#
# Compose reads `.env` automatically. Do NOT commit a populated `.env`.

# ---------------------------------------------------------------------------
# wrapper-v2 sidecar: Apple Music account (consumed by the wrapper container).
# ---------------------------------------------------------------------------
# An app-specific password is strongly recommended over your main password:
#   https://account.apple.com/  →  Sign-In and Security  →  App-Specific Passwords
USERNAME=you@example.com
PASSWORD=app-specific-password-here

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Public host port for the wrapper-v2 HTTP API. The image listens on :80
# inside the container; uncomment if you need to remap it on the host.
# HTTP_PORT=8080

# Target arch for compose builds. Defaults to x86_64; switch to arm64-v8a
# (with matching BUILD_PLATFORM / RUNTIME_PLATFORM) on Apple Silicon when
# you want a native arm64 build rather than emulated x86_64.
# TARGET_ARCH=x86_64
# BUILD_PLATFORM=linux/amd64
# RUNTIME_PLATFORM=linux/amd64

# Verbose stage-by-stage trace from the wrapper's Apple-lib loader.
# Useful when the daemon SIGSEGVs during init.
# WRAPPER_RUNTIME_TRACE=1
