{
  "version": "2.0.0",
  // Every task here is also a command-palette entry: Cmd+Shift+P, "Tasks: Run
  // Task", then the label. Only start-agents carries runOn folderOpen; the rest
  // exist purely to be run by hand from there.
  //
  // Each command is guarded, because this file is copied into every project and
  // repositories without scripts/agents/start-agents.sh must not get a failing
  // task on open or a confusing one in the palette.
  "tasks": [
    {
      "label": "start-agents",
      "type": "shell",
      // Open the tmux session (orchestrator / implementer / reviewer) as soon as
      // the folder opens. VS Code has no per-task property for terminal location,
      // so the editor-area placement comes from
      // "terminal.integrated.defaultLocation" in settings.json
      // (microsoft/vscode#212070).
      "command": "[ -x scripts/agents/start-agents.sh ] && exec scripts/agents/start-agents.sh || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        // This terminal owns tmux: never auto-close it, and do not echo the command.
        "reveal": "always",
        "panel": "dedicated",
        "echo": false,
        "close": false,
        "clear": true,
        // Show it without stealing focus from the editor.
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "restart-agents",
      "type": "shell",
      // Restart the three Claude Code seats after changing a model or a role
      // prompt: both are read when Claude starts, so a running seat keeps the old
      // ones until it is replaced. --restart swaps the process inside each pane
      // and leaves the session standing; --no-attach keeps this task from opening
      // a second view of the same session.
      //
      // It ends whatever the agents were in the middle of. Their conversations do
      // not survive, so run it between pieces of work rather than during one.
      "command": "[ -x scripts/agents/start-agents.sh ] && scripts/agents/start-agents.sh --restart --no-attach || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        // The result is visible in the start-agents terminal, so this one has
        // nothing worth showing and closes itself unless it fails.
        "reveal": "silent",
        "panel": "shared",
        "echo": false,
        "close": true,
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "attach-agents",
      "type": "shell",
      // Get a view of the session back after closing the start-agents terminal.
      // The script attaches to the session when one is running and builds it when
      // none is, so this is also the way back from an accidental kill.
      "command": "[ -x scripts/agents/start-agents.sh ] && exec scripts/agents/start-agents.sh || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "echo": false,
        "close": false,
        "clear": true,
        // Asked for by hand, unlike start-agents, so take the focus.
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
